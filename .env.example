# Copy this file to `.env` and fill in your own Supabase project values.
# These are read by the Vercel serverless functions (api/_supabase.ts) at runtime.
# The `.env` file is gitignored and must never be committed.

# Your Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Service-role key (Supabase dashboard -> Project Settings -> API Keys -> service_role / secret).
# SERVER-ONLY. The API uses this key and enforces GM-key ownership itself; the public
# anon role has no access to the screamsheets table. Never expose it to the browser
# and never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Optional: the public anon key. Only used by script/check-anon-lockdown.ts to prove
# that anon access is refused, and as a temporary fallback if the service key is unset.
SUPABASE_ANON_KEY=<your-anon-jwt>
